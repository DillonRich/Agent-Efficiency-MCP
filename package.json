{
  "name": "agent-efficiency-mcp",
  "version": "1.4.8",
  "description": "Agent Efficiency Engine — local BYOK MCP that rewrites messy prompts into Agent_Efficiency_MCP.md and freezes until GO.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "agent-efficiency-mcp": "dist/cli.js",
    "promptmcp": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "init": "tsx src/cli.ts init",
    "dev": "tsx src/server.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:offline": "tsx scripts/smoke.ts --offline",
    "test": "tsx --test test/**/*.test.ts",
    "test:ci": "npm run build && npm test",
    "eval": "tsx scripts/eval-providers.ts",
    "eval:mock": "tsx scripts/eval-providers.ts --provider mock",
    "eval-trend": "tsx scripts/eval-trend.ts",
    "flake-check": "tsx scripts/flake-check.ts",
    "quality-loop": "tsx scripts/quality-loop.ts",
    "measure-context": "tsx scripts/measure-context-budget.ts",
    "dogfood-summary": "tsx scripts/dogfood-summary.ts",
    "auto-dogfood": "tsx scripts/auto-dogfood.ts",
    "doctor": "tsx src/cli.ts doctor",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck && npm test && npm run smoke:offline && npm run eval:mock && npm run flake-check && npm run auto-dogfood"
  },
  "keywords": [
    "mcp",
    "agent-efficiency",
    "prompt",
    "cursor",
    "byok",
    "open-source",
    "claude",
    "windsurf",
    "vscode"
  ],
  "author": "Agent Efficiency MCP <AgentEfficiencyMCP@gmail.com>",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "templates",
    "docs/DIRECTIVES.md",
    "docs/INSTALL.md",
    "docs/PRIVACY.md",
    "docs/SECURITY.md",
    "docs/HOSTS.md",
    "docs/COMMERCIAL.md",
    "docs/TROUBLESHOOTING.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    ".env.example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Agent-Efficiency-MCP/Agent-Efficiency-MCP.git"
  },
  "bugs": {
    "url": "https://github.com/Agent-Efficiency-MCP/Agent-Efficiency-MCP/issues"
  },
  "homepage": "https://github.com/Agent-Efficiency-MCP/Agent-Efficiency-MCP#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
