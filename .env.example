# =============================================================================
# PromptMCP — BYOK / local LLM config
# Pick ONE provider block (or REWRITE_PROVIDER=auto and fill the first you use).
# =============================================================================

# Optional universal model override (aliases or exact API ids work):
# REWRITE_MODEL=sonnet 4

REWRITE_PROVIDER=auto

# --- DeepSeek ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=flash
# Aliases: flash | chat | reasoner

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1-mini

# --- Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=sonnet 4

# --- Google Gemini ---
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash
# Aliases: gemini-flash | gemini-pro

# --- xAI Grok ---
# XAI_API_KEY=...
# (GROK_API_KEY also accepted)
# XAI_MODEL=grok-3-mini
# Aliases: grok | grok-3 | grok-mini
# REWRITE_PROVIDER=xai   # or: grok

# --- Fully local / private (Ollama, LM Studio, vLLM, llama.cpp, mini-PC) ---
# Prompts stay on your LAN. Default base = Ollama on this machine.
# REWRITE_PROVIDER=local
# LOCAL_LLM_BASE=http://127.0.0.1:11434/v1
# LOCAL_LLM_MODEL=llama3.1
# LOCAL_LLM_API_KEY=ollama
#
# Adjacent AI mini-PC on your LAN (example):
# LOCAL_LLM_BASE=http://192.168.1.50:11434/v1
# LOCAL_LLM_MODEL=qwen2.5-coder:14b
#
# LM Studio (OpenAI server usually on :1234):
# LOCAL_LLM_BASE=http://127.0.0.1:1234/v1
# LOCAL_LLM_MODEL=local-model
#
# Aliases for provider: local | ollama | lmstudio | vllm

# --- Any other OpenAI-compatible cloud (OpenRouter, Together, Fireworks, …) ---
# REWRITE_PROVIDER=openai_compat
# REWRITE_API_BASE=https://openrouter.ai/api/v1
# REWRITE_API_KEY=...
# REWRITE_API_MODEL=...

# Optional: blueprint filename (default Agent_Efficiency_MCP.md)
# PROMPT_MCP_BLUEPRINT=Agent_Efficiency_MCP.md

# Optional: generate blueprint but do not write to disk
# PROMPT_MCP_DRY_RUN=1

# Optional: fetch page title/snippet for @promptmcp:search (default on)
# Private/localhost URLs are blocked (SSRF guard).
# PROMPT_MCP_FETCH_URLS=1
# PROMPT_MCP_ENRICH_TIMEOUT_MS=4000
# PROMPT_MCP_HTTP_TIMEOUT_MS=45000
# PROMPT_MCP_HTTP_RETRIES=2

# Optional: attach @promptmcp:media images to vision-capable rewriters (default on)
# PROMPT_MCP_VISION=1
# PROMPT_MCP_VISION_MAX=3
# PROMPT_MCP_VISION_MAX_BYTES=4194304

# Optional: archive previous blueprints under .promptmcp/history/ (default on)
# PROMPT_MCP_KEEP_HISTORY=1
# PROMPT_MCP_HISTORY_LIMIT=20

# Optional: MCP launch mode for init (node | npx)
# PROMPT_MCP_LAUNCH=node

# Optional: fallback workspace root if the agent omits workspace_root
# PROMPT_MCP_WORKSPACE=C:\path\to\your\project

# Optional: per-provider API base overrides
# DEEPSEEK_API_BASE=https://api.deepseek.com
# OPENAI_API_BASE=https://api.openai.com/v1
# ANTHROPIC_API_BASE=https://api.anthropic.com
# GEMINI_API_BASE=https://generativelanguage.googleapis.com
# XAI_API_BASE=https://api.x.ai/v1
# GROK_API_BASE=https://api.x.ai/v1
# GROK_MODEL=grok-3-mini

# Optional: auth circuit breaker (repeated 401/403)
# PROMPT_MCP_AUTH_FAIL_THRESHOLD=3
# PROMPT_MCP_AUTH_COOLDOWN_MS=300000

# Dev / CI only
# PROMPT_MCP_SMOKE_OFFLINE=1
# PROMPT_MCP_FLAKE_MAX_SPREAD=5
